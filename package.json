{
  "name": "website-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "postinstall": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "db:push:sqlite": "prisma db push --schema prisma/schema.prisma",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:migrate:postgres:predeploy": "node scripts/predeploy-postgres.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "googleapis": "^178.0.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "nodemailer": "^10.1.1",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
